# USSD Service Configuration
USSD_PORT=4000
NODE_ENV=development

# Backend API Configuration
BACKEND_API_URL=http://localhost:3000/api
BACKEND_API_KEY=your-backend-api-key

# Telecom Gateway Configuration
TELECOM_GATEWAY_URL=your-telecom-gateway-url
TELECOM_API_KEY=your-telecom-api-key
TELECOM_SHORT_CODE=*182*24#

# Session Management
SESSION_TIMEOUT=300000
MAX_SESSIONS=1000

# Logging
LOG_LEVEL=info

# Security
ALLOWED_IPS=127.0.0.1,::1
