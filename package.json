{
  "name": "rwanda-safe-pay",
  "version": "1.0.0",
  "description": "A Digital Safety and Community Payment Platform for Kigali",
  "main": "index.js",
  "scripts": {
    "install-all": "npm run install-backend && npm run install-mobile && npm run install-web",
    "install-backend": "cd backend && npm install",
    "install-mobile": "cd mobile-app && npm install",
    "install-web": "cd web-dashboard && npm install",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-web\"",
    "dev-backend": "cd backend && npm run dev",
    "dev-web": "cd web-dashboard && npm start",
    "dev-mobile": "cd mobile-app && npm start",
    "build": "npm run build-backend && npm run build-web",
    "build-backend": "cd backend && npm run build",
    "build-web": "cd web-dashboard && npm run build",
    "test": "npm run test-backend && npm run test-web && npm run test-mobile",
    "test-backend": "cd backend && npm test",
    "test-web": "cd web-dashboard && npm test",
    "test-mobile": "cd mobile-app && npm test"
  },
  "keywords": [
    "rwanda",
    "safety",
    "payment",
    "community",
    "kigali",
    "emergency",
    "sos",
    "irondo"
  ],
  "author": "Rwanda Safe Pay Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "backend",
    "mobile-app",
    "web-dashboard",
    "ussd-service"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lanari24/safepay.git"
  },
  "bugs": {
    "url": "https://github.com/lanari24/safepay/issues"
  },
  "homepage": "https://github.com/lanari24/safepay#readme"
}
