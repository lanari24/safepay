{
  "name": "rwanda-safe-pay",
  "version": "1.0.0",
  "description": "A Digital Safety and Community Payment Platform for Kigali",
  "main": "index.js",
  "scripts": {
    "install-all": "npm run install-backend && npm run install-mobile && npm run install-web && npm run install-ussd",
    "install-backend": "cd backend && npm install",
    "install-mobile": "cd mobile-app && npm install",
    "install-web": "cd web-dashboard && npm install",
    "install-ussd": "cd ussd-service && npm install",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-web\" \"npm run dev-ussd\"",
    "dev-backend": "cd backend && npm run dev",
    "dev-web": "cd web-dashboard && npm start",
    "dev-mobile": "cd mobile-app && npm start",
    "dev-ussd": "cd ussd-service && npm run dev",
    "build": "npm run build-backend && npm run build-web",
    "build-backend": "cd backend && npm run build",
    "build-web": "cd web-dashboard && npm run build",
    "build-mobile": "cd mobile-app && expo build:android && expo build:ios",
    "test": "npm run test-backend && npm run test-web && npm run test-mobile && npm run test-ussd",
    "test-backend": "cd backend && npm test",
    "test-web": "cd web-dashboard && npm test -- --watchAll=false",
    "test-mobile": "cd mobile-app && npm test -- --watchAll=false",
    "test-ussd": "cd ussd-service && npm test",
    "test-all": "./scripts/test-all.sh",
    "lint": "npm run lint-backend && npm run lint-web && npm run lint-mobile && npm run lint-ussd",
    "lint-backend": "cd backend && npm run lint",
    "lint-web": "cd web-dashboard && npm run lint",
    "lint-mobile": "cd mobile-app && npm run lint",
    "lint-ussd": "cd ussd-service && npm run lint",
    "deploy": "./scripts/deploy.sh",
    "deploy-dev": "./scripts/deploy.sh development",
    "deploy-prod": "./scripts/deploy.sh production",
    "docker-up": "docker-compose up -d",
    "docker-down": "docker-compose down",
    "docker-logs": "docker-compose logs -f",
    "setup": "node scripts/setup-dev.js"
  },
  "keywords": [
    "rwanda",
    "safety",
    "payment",
    "community",
    "kigali",
    "emergency",
    "sos",
    "irondo"
  ],
  "author": "Rwanda Safe Pay Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "backend",
    "mobile-app",
    "web-dashboard",
    "ussd-service"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lanari24/safepay.git"
  },
  "bugs": {
    "url": "https://github.com/lanari24/safepay/issues"
  },
  "homepage": "https://github.com/lanari24/safepay#readme"
}
